{
  "name": "@sharadox/sharadox-mta-sts-web-application",
  "version": "0.1.0",
  "description": "The MTA-STS policy for sharadox.com mail, served on mta-sts.sharadox.com.",
  "private": true,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify": "turbo run format:check type-check test:unit",
    "prepare": "turborepo-configuration node"
  },
  "devDependencies": {
    "@sharadox/prettier-configuration-web-library": "^0.1.1",
    "@sharadox/turborepo-configuration-web-library": "^0.1.1",
    "@sharadox/type-script-configuration-web-library": "^0.2.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
